  "measurement_script": "import json,time\nfrom engine.resize import resize\nfrom engine.layout import visual_bounds\nfrom evaluation.catalogue import sources,FORMATS\ncases=[(name+'@'+fmt,s,dict(width=w,height=h)) for name,s in sources() for fmt,(w,h) in FORMATS.items()]\nrecords={}\nfor name,s,t in cases:\n d=resize(s,t)\n records[name]={'design':d,'images':{e['id']:visual_bounds([e]) for e in d['elements'] if e['type']=='image'}}\ntimes=[]\nfor _ in range(5):\n start=time.perf_counter()\n for _,s,t in cases:resize(s,t)\n times.append(time.perf_counter()-start)\nprint(json.dumps({'records':records,'warm_sweep_seconds':times}))\n"
